generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  ADMIN
}

enum Plan {
  FREE
  PREMIUM
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  MCQ
  TRUE_FALSE
  FILL_BLANK
}

enum PaymentMethod {
  MTN_MOMO
  AIRTEL_MONEY
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  hashedPassword String?
  image          String?
  role           Role      @default(STUDENT)
  plan           Plan      @default(FREE)
  planExpiresAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  progress     Progress[]
  bookmarks    Bookmark[]
  quizAttempts QuizAttempt[]
  payments     Payment[]
  accounts     Account[]
  sessions     Session[]

  @@map("users")
}

// NextAuth adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Subject {
  id          String @id @default(cuid())
  name        String
  slug        String @unique
  icon        String
  description String @db.Text
  color       String
  order       Int    @default(0)

  topics Topic[]

  @@map("subjects")
}

model Topic {
  id          String  @id @default(cuid())
  subjectId   String
  title       String
  slug        String
  description String  @db.Text
  isPremium   Boolean @default(false)
  order       Int     @default(0)

  subject   Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  notes     Note[]
  videos    Video[]
  questions Question[]
  progress  Progress[]

  @@unique([subjectId, slug])
  @@map("topics")
}

model Note {
  id        String   @id @default(cuid())
  topicId   String
  title     String
  content   String   @db.Text
  isPremium Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  topic  Topic       @relation(fields: [topicId], references: [id], onDelete: Cascade)
  images NoteImage[]

  @@map("notes")
}

model NoteImage {
  id      String  @id @default(cuid())
  noteId  String
  url     String
  caption String?
  alt     String?

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@map("note_images")
}

model Video {
  id          String  @id @default(cuid())
  topicId     String
  title       String
  youtubeId   String
  description String  @db.Text
  duration    Int
  isPremium   Boolean @default(false)
  order       Int     @default(0)

  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@map("videos")
}

model Question {
  id                String       @id @default(cuid())
  topicId           String
  text              String       @db.Text
  imageUrl          String?
  explanation       String       @db.Text
  explanationImage  String?
  isPremium         Boolean      @default(false)
  difficulty        Difficulty   @default(MEDIUM)
  type              QuestionType @default(MCQ)
  examYear          Int?

  topic        Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  options      Option[]
  quizAttempts QuizAttempt[]
  bookmarks    Bookmark[]

  @@map("questions")
}

model Option {
  id         String  @id @default(cuid())
  questionId String
  text       String
  isCorrect  Boolean @default(false)
  order      Int     @default(0)

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("options")
}

model QuizAttempt {
  id               String   @id @default(cuid())
  userId           String
  questionId       String
  selectedOptionId String?
  isCorrect        Boolean
  createdAt        DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("quiz_attempts")
}

model Progress {
  id            String   @id @default(cuid())
  userId        String
  topicId       String
  completed     Boolean  @default(false)
  lastQuizScore Float?
  updatedAt     DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic Topic @relation(fields: [topicId], references: [id], onDelete: Cascade)

  @@unique([userId, topicId])
  @@map("progress")
}

model Bookmark {
  id         String   @id @default(cuid())
  userId     String
  questionId String?
  createdAt  DateTime @default(now())

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question? @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("bookmarks")
}

model Payment {
  id                String        @id @default(cuid())
  userId            String
  amount            Int
  currency          String        @default("UGX")
  method            PaymentMethod
  flutterwaveTxRef  String        @unique
  status            PaymentStatus @default(PENDING)
  planPurchased     Plan
  months            Int
  createdAt         DateTime      @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("payments")
}
